{
  "hooks": {
    "before:init": ["npm run typecheck", "npm test"]
  },
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "requireCleanWorkingDir": true,
    "requireUpstream": true
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": false
  }
}
